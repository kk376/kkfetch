#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	mkdir -p .cargo
	cp debian/vendor-config.toml .cargo/config.toml
	find vendor -name Cargo.toml -exec sed -i -e 's/edition = "2024"/edition = "2021"/' -e 's/rust-version = "1.85"/rust-version = "1.74"/' {} +
	if grep -q 'version = "1.1.0"' vendor/clap_lex/Cargo.toml 2>/dev/null; then \
		sed -i 's/version = "1.0.0"/version = "1.1.0"/' Cargo.lock; \
		sed -i 's/3a822ea5bc7590f9d40f1ba12c0dc3c2760f3482c6984db1573ad11031420831/c8d4a3bb8b1e0c1050499d1815f5ab16d04f0959b233085fb31653fbfc9d98f9/' Cargo.lock; \
	fi
	cargo build --release --offline

override_dh_auto_test:
	cargo test --release --offline --lib

override_dh_auto_install:
	# Install binary
	install -d debian/kkfetch/usr/bin
	install -m 0755 target/release/kkfetch debian/kkfetch/usr/bin/kkfetch
	# Install shell completions
	install -d debian/kkfetch/usr/share/bash-completion/completions
	install -m 0644 completions/kkfetch.bash debian/kkfetch/usr/share/bash-completion/completions/kkfetch
	install -d debian/kkfetch/usr/share/zsh/vendor-completions
	install -m 0644 completions/_kkfetch debian/kkfetch/usr/share/zsh/vendor-completions/_kkfetch
	install -d debian/kkfetch/usr/share/fish/vendor_completions.d
	install -m 0644 completions/kkfetch.fish debian/kkfetch/usr/share/fish/vendor_completions.d/kkfetch.fish
	# Install manpage
	install -d debian/kkfetch/usr/share/man/man1
	if [ -f docs/kkfetch.1 ]; then \
		gzip -9cn docs/kkfetch.1 > debian/kkfetch/usr/share/man/man1/kkfetch.1.gz; \
	fi
	# Install documentation
	install -d debian/kkfetch/usr/share/doc/kkfetch
	install -m 0644 README.md debian/kkfetch/usr/share/doc/kkfetch/README.md

override_dh_auto_clean:
	rm -rf .cargo
	cargo clean || true
	dh_auto_clean
